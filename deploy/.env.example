# Only read on first start, when /data/hub.json does not exist yet.
HUB_TOKEN=change-me
# Address devices use to reach the clients WireGuard port.
CLIENTS_ENDPOINT=192.0.2.10
# Published host ports.
HUB_PORT=8080
UNDERLAY_PORT=51820
CLIENTS_PORT=51821
# Default SSH public keys offered as hub keys.
HUB_SSH_DIR=~/.ssh
