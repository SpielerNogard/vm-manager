# Published host ports; all other settings live in the GUI.
HUB_PORT=8080
UNDERLAY_PORT=51820
CLIENTS_PORT=51821
STORAGE_PORT=10809
# host:port nodes use to reach the storage container's NBD port (compose profile "storage").
STORAGE_ENDPOINT=192.0.2.10:10809
# Default SSH public keys offered as hub keys.
HUB_SSH_DIR=~/.ssh
