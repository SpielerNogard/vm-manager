# Release to run (https://github.com/SpielerNogard/vm-manager/releases); hub, gateway and storage use its binaries.
VMM_VERSION=v0.1.0
# Published host ports; all other settings live in the GUI.
HUB_PORT=8080
UNDERLAY_PORT=51820
CLIENTS_PORT=51821
STORAGE_PORT=10809
# Default SSH public keys offered as hub keys.
HUB_SSH_DIR=~/.ssh
