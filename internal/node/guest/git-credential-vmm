#!/bin/sh
# git credential helper: answers get for https://github.com from the vmm token service, nothing otherwise.
[ "${1-}" = get ] || exit 0
protocol='' host=''
while IFS= read -r line && [ -n "$line" ]; do
  case $line in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
  esac
done
[ "$protocol" = https ] && [ "$host" = github.com ] || exit 0
token=$(curl -fsS --max-time 1 "${VMM_TOKENS_URL:-http://10.201.0.1:9002}/v1/github/token" 2>/dev/null) || exit 0
# Same charset as vmm-sync; a newline would inject lines into git's credential protocol.
case $token in '' | *[!A-Za-z0-9._~+/=-]*) exit 0 ;; esac
printf 'username=x-access-token\npassword=%s\n' "$token"
exit 0
