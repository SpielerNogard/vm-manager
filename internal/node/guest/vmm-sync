#!/bin/sh
# Runs as root from vmm-integrations.timer: installs gh and Claude Code, syncs the GitHub git config, Claude credentials and the Linear MCP server.
umask 077
url=${VMM_TOKENS_URL:-http://10.201.0.1:9002}
user=${VMM_USER:-ubuntu}
state=${VMM_STATE_DIR:-/var/lib/vmm}
home=$(getent passwd "$user" | cut -d: -f6)
[ -n "$home" ] || { echo "vmm-sync: no user $user, nothing to sync" >&2; exit 0; }
creds=${VMM_CLAUDE_CREDENTIALS:-$home/.claude/.credentials.json}
claude=${VMM_CLAUDE_BIN:-$home/.local/bin/claude}
gitconfig=${VMM_GITCONFIG:-/etc/gitconfig}
include_path='	path = /etc/vmm/gitconfig'

# runuser keeps root's environment, so claude would otherwise write its user config into root's home.
as_user() {
  set -- env HOME="$home" USER="$user" LOGNAME="$user" "$@"
  if [ "$(id -un)" = "$user" ]; then "$@"; else runuser -u "$user" -- "$@"; fi
}

sha() { sha256sum | cut -d' ' -f1; }

body=$(mktemp) || exit 1
trap 'rm -f "$body"' EXIT

# Sets code (000 when unreachable) and token; a token with characters outside this set is not used.
fetch() {
  : >"$body"
  code=$(curl -fsS --max-time 3 -o "$body" -w '%{http_code}' "$url/v1/$1/token" 2>/dev/null)
  token=$(cat "$body")
  case $token in '' | *[!A-Za-z0-9._~+/=-]*) [ "$code" = 200 ] && code=000 ;; esac
}

# Runs after the sync, so a hung download never holds back credentials; side by side and bounded, so one never blocks the other.
install_missing() {
  [ "${VMM_SKIP_INSTALL-}" != 1 ] || return 0
  [ -x /usr/bin/gh ] || timeout 120 sh -c 'apt-get -q update && DEBIAN_FRONTEND=noninteractive apt-get -q -y install gh' &
  [ -x "$claude" ] || as_user timeout 120 sh -c 'curl -fsSL https://claude.ai/install.sh | bash' &
  wait
}

has_include() { awk -v p="$include_path" 'held && $0 == p { found = 1 } { held = $0 == "[include]" } END { exit !found }' "$gitconfig" 2>/dev/null; }

# Rewrites git@github.com: remotes to https only while a token is served, so other VMs keep stock SSH git.
fetch github
case $code in
  200)
    if ! has_include; then
      [ -s "$gitconfig" ] && [ -n "$(tail -c1 "$gitconfig")" ] && echo >>"$gitconfig"
      (umask 022 && printf '[include]\n%s\n' "$include_path" >>"$gitconfig")
    fi
    ;;
  403 | 404)
    if has_include; then
      # Drops our path line, and its [include] header unless the user added keys below it; replaced by rename with the old owner and mode.
      kept=$(mktemp "$gitconfig.XXXXXX") && awk -v p="$include_path" '
        { l[NR] = $0 }
        END {
          for (i = 1; i <= NR; i++) {
            if (l[i] == "[include]" && l[i + 1] == p) {
              j = i + 2
              while (j <= NR && l[j] ~ /^[ \t]*([#;].*)?$/) j++
              if (j <= NR && l[j] !~ /^[ \t]*\[/) print l[i]
              i++
              continue
            }
            print l[i]
          }
        }' "$gitconfig" >"$kept" &&
        chmod --reference="$gitconfig" "$kept" && chown --reference="$gitconfig" "$kept" && mv -f "$kept" "$gitconfig"
      rm -f "$kept"
    fi
    ;;
esac

[ -x "$claude" ] || { install_missing; exit 0; }

mkdir -p "$state"
fetch claude
hashfile=$state/claude-credentials.sha256
# Only a missing file or one this script wrote is ours to touch; a user's own /login stays.
# The file is read, written and removed as the user, so a link planted in their directory gets no root access.
current=
if as_user test -e "$creds"; then
  current=$(as_user cat "$creds" 2>/dev/null | sha)
  grep -qxF "$current" "$hashfile" 2>/dev/null || code=foreign
fi
case $code in
  200)
    json=$(printf '{"claudeAiOauth":{"accessToken":"%s","refreshToken":null,"expiresAt":null,"scopes":["user:inference"]}}' "$token")
    h=$(printf '%s\n' "$json" | sha)
    if [ "$h" != "$current" ]; then
      as_user mkdir -p "$(dirname "$creds")"
      # The new hash is added before the rename and the old one dropped after, so the file always matches a recorded hash.
      printf '%s\n' "$h" >>"$hashfile" &&
        printf '%s\n' "$json" | as_user sh -c 'umask 077; t=$(mktemp "$1.XXXXXX") && cat >"$t" && mv -f "$t" "$1"' sh "$creds" &&
        printf '%s\n' "$h" >"$hashfile"
    fi
    ;;
  403 | 404) as_user rm -f "$creds" && rm -f "$hashfile" ;;
esac

fetch linear
hashfile=$state/linear.sha256
case $code in
  200)
    h=$(printf '%s' "$token" | sha)
    if [ "$h" != "$(cat "$hashfile" 2>/dev/null)" ]; then
      [ -f "$hashfile" ] && as_user "$claude" mcp remove --scope user linear >/dev/null 2>&1
      as_user "$claude" mcp add --transport http --scope user linear https://mcp.linear.app/mcp \
        --header "Authorization: Bearer $token" >/dev/null 2>&1 && printf '%s\n' "$h" >"$hashfile"
    fi
    ;;
  403 | 404)
    if [ -f "$hashfile" ]; then
      as_user "$claude" mcp remove --scope user linear >/dev/null 2>&1
      rm -f "$hashfile"
    fi
    ;;
esac
install_missing
exit 0
